# GHOST THREAD — environment template (Task 1)
# Copy to `.env` and fill in. NEVER commit a populated `.env`.
# Every value below is a placeholder; the scaffold runs fine with all of them unset.

# ----------------------------------------------------------------------------
# Runtime / service wiring
# ----------------------------------------------------------------------------
GHOST_ENV=local                       # local | staging | prod
GHOST_LOG_LEVEL=INFO                  # DEBUG | INFO | RESULT | WARNING | ERROR
GHOST_API_HOST=0.0.0.0
GHOST_API_PORT=8000
GHOST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend dev-server proxy target (browser always calls the relative /api prefix)
VITE_API_TARGET=http://127.0.0.1:8000

# ----------------------------------------------------------------------------
# Case data directories (evidence lockers, journals, SQLite store, snapshots)
# ----------------------------------------------------------------------------
GHOST_CASE_DATA_DIR=./data/cases      # per-case evidence lockers + manifests
GHOST_JOURNAL_DIR=./data/journals     # JSONL event journals (evidentiary output)
GHOST_SQLITE_PATH=./data/ghost_thread.db  # SQLite WAL+FTS5 system of record
GHOST_CAPTURE_DIR=./data/captures     # screenshots / HAR / PDF / video captures

# ----------------------------------------------------------------------------
# LLM provider keys (routed through the gateway in backend/app/llm/)
# ----------------------------------------------------------------------------
OPENAI_API_KEY=sk-placeholder
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=sk-ant-placeholder
GOOGLE_API_KEY=placeholder
GROQ_API_KEY=placeholder
OPENROUTER_API_KEY=placeholder
LITELLM_MASTER_KEY=placeholder
GHOST_FAST_LLM=openai:gpt-4o-mini
GHOST_SMART_LLM=openai:gpt-4o
GHOST_EMBEDDING_MODEL=openai:text-embedding-3-small

# ----------------------------------------------------------------------------
# Search / retrieval provider keys
# ----------------------------------------------------------------------------
TAVILY_API_KEY=placeholder
EXA_API_KEY=placeholder
BRAVE_SEARCH_API_KEY=placeholder
SERPAPI_API_KEY=placeholder
BING_SEARCH_API_KEY=placeholder
GHOST_DEFAULT_RETRIEVERS=tavily,exa    # comma separated; quorum needs >= 2

# ----------------------------------------------------------------------------
# Registry / archival / infrastructure endpoints (structural-absence hunting)
# ----------------------------------------------------------------------------
COMPANIES_HOUSE_API_KEY=placeholder
COMPANIES_HOUSE_ENDPOINT=https://api.company-information.service.gov.uk
SEC_EDGAR_ENDPOINT=https://data.sec.gov
SEC_EDGAR_USER_AGENT=ghost-thread/0.1 (contact@example.com)
OPENCORPORATES_API_KEY=placeholder
OPENCORPORATES_ENDPOINT=https://api.opencorporates.com/v0.4
TRADEMARK_REGISTRY_ENDPOINT=https://tmsearch.example.org/api
WAYBACK_ENDPOINT=https://web.archive.org
WHOIS_API_KEY=placeholder
WHOIS_ENDPOINT=https://api.whoisxmlapi.com/v1

# ----------------------------------------------------------------------------
# Worker / browser capture tier (pinned for deterministic captures)
# ----------------------------------------------------------------------------
PLAYWRIGHT_VERSION=1.47.0
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
GHOST_BROWSER_CHANNEL=chromium
GHOST_BROWSER_HEADLESS=true
GHOST_WORKER_CONCURRENCY=2

# ----------------------------------------------------------------------------
# Observability + cost budgets
# ----------------------------------------------------------------------------
LMNR_PROJECT_API_KEY=placeholder      # Laminar tracing; no-op when unset
GHOST_COST_BUDGET_USD=5.00            # per-case ceiling
GHOST_GAP_COST_BUDGET_USD=0.50        # per-gap-thread ceiling
